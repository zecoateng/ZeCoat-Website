---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<html>
  <body>
    <div class="page">
      <Header />

      <main>
        <slot />
      </main>

      <Footer />
    </div>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: #ECEFF3
  }

  main {
    flex: 1;
  }
</style>