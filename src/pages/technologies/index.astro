---
import Layout from "../../layouts/layout.astro"
import TechnologyList from "../../components/TechnologyList.astro"

export const technologies = [
  {
    title: "Silicon Cladding for Lightweight Mirrors",
    description:
      "Lightweight mirror substrates are notoriously hard to polish to an optical finish. ZeCoat's low-stress silicon cladding, applied by pulsed ion-assisted evaporation, adds a dense, polishable surface without distorting the mirror's figure — giving next-generation telescopes both low mass and optical-quality optics.",
    image: "/SiliconCladding.webp",
    link: "/technologies/SiliconCladding"
  },
  {
    title: "Starshades & Stray-Light Suppression",
    description:
      "ZeCoat develops antireflection and black coatings that suppress stray light, scattering, and solar glint from starshade membranes and optical edges. Applied by processes including roll-to-roll coating of large flexible membranes, they help future space telescopes reach the extreme contrast needed for direct exoplanet imaging.",
    image: "/Starshade.webp",
    link: "/technologies/Starshade"
  },
  {
    title: "FUV & Broadband Mirror Coatings",
    description:
      "ZeCoat develops protected-aluminum coatings that maximize far-ultraviolet reflectance, letting next-generation telescopes and instruments capture faint UV signals with exceptional efficiency. Precise deposition control — and large-area, multi-source methods — extends these coatings toward the largest future mirrors.",
    image: "/FUVImage.webp",
    link: "/technologies/FUVCoating"
  },
  {
    title: "Self-Coating Telescope",
    description:
      "An aluminum mirror oxidizes the moment it meets air, which cuts off far-ultraviolet reflectance. ZeCoat's self-coating telescope carries a compact, battery-powered deposition system that lays down a fresh, bare aluminum surface in orbit — reaching deeper into the ultraviolet and letting a mission refresh its own mirror.",
    image: "/SelfCoatingTelescope.webp",
    link: "/technologies/SelfCoating"
  },
  {
    title: "Micrometeroid Protection",
    description:
      "Over years in orbit, micrometeoroids slowly pit and roughen a telescope mirror, raising scattered light. ZeCoat draws on its durable protective overcoats and in-space coating capability to help optical surfaces resist this erosion — and, where damage accumulates, to restore them by re-coating on orbit.",
    image: "/MicrometeroidImage.webp",
    link: "/technologies/MicroProtect"
  }
];
---

<Layout>
    <div class = "page-layout">
        <div class = "page-header">
            <h1 class = "title">Research, Publications & Funded Programs</h1>
        <div>
            ZeCoat has developed a portfolio of advanced coating technologies engineered for the most demanding space, astronomy, and areospace applications. Each solution is built on decades of research experience, precision deposition experitise, and a commitment to mission success.
            </div>
        </div>
        <div class = "Technology-List">
        {
  technologies.map((technology) => (
    <TechnologyList
      title={technology.title}
      description={technology.description}
      image={technology.image}
      link={technology.link}
    />
  ))
}
        </div>
    </div>
    

</Layout>

<style>

.page-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
}

.page-header {
    text-align: center;
    width: 100%;
    max-width: 800px;
    margin-top: 10px;
    margin-bottom: 2.5rem;
}

.page-header h1 {
    font-size: clamp(2rem, 4vw + 1rem, 60px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
}

.page-header div {
    color: #475569;
    line-height: 1.7;
}

