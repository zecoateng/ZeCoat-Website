---
import Layout from "../../layouts/layout.astro"
import TechnologyList from "../../components/TechnologyList.astro"

export const technologies = [
  {
    title: "Battery-Powered Deposition",
    description:
      "ZeCoat is developing a new and novel way of depositing a thin film optical coating. This new method uses many small evaporation sources that fire simultaneously in a controlled manner. This application process allows a large mirror to be uniformly coated in a matter of seconds. There are several advantages to this method of coating, including: ",
    image: "/dock-layout.png",
    link: "/technologies/BPD"
  },
  {
    title: "Advanced Dielectric Coatings",
    description:
      "ZeCoat is developing a new and novel way of depositing a thin film optical coating. This new method uses many small evaporation sources that fire simultaneously in a controlled manner. This application process allows a large mirror to be uniformly coated in a matter of seconds. There are several advantages to this method of coating, including: ",
    image: "/dock-layout.png",
    link: "/technologies/Technology2"
  },
  {
    title: "Protected Silver Coatings",
    description:
      "ZeCoat is developing a new and novel way of depositing a thin film optical coating. This new method uses many small evaporation sources that fire simultaneously in a controlled manner. This application process allows a large mirror to be uniformly coated in a matter of seconds. There are several advantages to this method of coating, including: ",
    image: "/dock-layout.png",
    link: "/technologies/Technology3"
  }
];
---

<Layout>
    <div class = "page-layout">
        <div class = "page-header">
            <h1>Technologies</h1>
        <div>
            ZeCoat has developed a portfolio of advanced coating technologies engineered for the most demanding space, astronomy, and areospace applications. Each solution is built on decades of research, precision deposition experitise, and a commitment to mission success
            </div>
        </div>
        <h2 class = "layout-header">Current Research and Development</h2>
        <div class = "Technology-List">
        {
  technologies.map((technology) => (
    <TechnologyList
      title={technology.title}
      description={technology.description}
      image={technology.image}
      link={technology.link}
    />
  ))
}
        </div>
    </div>
    

</Layout>

<style>

.page-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
    
}

.page-header {
    text-align: center;
    width: 100%;
    max-width: 800px;
}

.layout-header  {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 2.5rem;
}

.layout-header {
    margin-top: 50px;
}

.Technology-List {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

@media (max-width: 900px) {
    .page-layout {
        padding: 1.5rem;
    }

    .page-header {
        text-align: center;
    }

    .layout-header {
        margin-top: 2rem;
    }

    .Technology-List {
        width: 100%;
    }
}


@media (max-width: 600px) {
    .page-layout {
        padding: 1rem;
    }

    .page-header h1 {
        font-size: 2rem;
    }

    .page-header div {
        font-size: 1rem;
        line-height: 1.6;
    }

    .layout-header {
        font-size: 1.6rem;
        margin-bottom: 1.5rem;
    }
}

</style>
