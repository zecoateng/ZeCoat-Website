---
import Layout from '../layouts/layout.astro'
import CoatingTile from '../components/CoatingTile.astro'

const coatings = [
  {
    title: "Protected Silver",
    image: "/ProtectiveSilver.webp",
    description:
      "High-performance protected silver coating delivering exceptional broadband reflectance across the visible and near-infrared. A flight-proven workhorse for astronomical and imaging optics.",
    link: "/coatings/protected-silver"
  },
  {
    title: "Protected Gold",
    image: "/ProtectedGold.webp",
    description:
      "Infrared gold coating offering extremely high reflectance from the near- to mid-infrared, protected for handling and long-term stability.",
    link: "/coatings/protected-gold"
  },
  {
    title: "Protected Aluminum",
    image: "/ProtectedAluminum.webp",
    description:
      "Broadband aluminum coatings for general-purpose optics, with a far-ultraviolet variant optimized for next-generation UV space telescopes.",
    link: "/coatings/protected-aluminum"
  },
  {
    title: "Black Coatings",
    image: "/BlackCoating.webp",
    description:
      "Low-reflectance black coating for stray-light suppression and contrast control on baffles, edges, and optical structures.",
    link: "/coatings/black-coatings"
  },
  {
    title: "Silicon Cladding",
    image: "/SiliconCladding.webp",
    description:
      "Tailorable silicon cladding over 100 microns thick for optical finishing, figure correction, and near-zero-CTE surfaces.",
    link: "/coatings/silicon-cladding"
  },
  {
    title: "Roll to Roll",
    image: "/RolltoRollCoating.webp",
    description:
      "Continuous vacuum deposition onto large, flexible membranes and films, extending our coatings to large-format space structures.",
    link: "/coatings/roll-to-roll"
  }
];
---

<Layout>

  <section class="standard-coatings">
    <div class="section-heading">
      <h2>Commercial Coatings</h2>
      <p>Explore our portfolio of standard commercial coatings. Click a coating to see its available variations, specifications, and heritage. If you are interested in a specific material or would like additional information, please visit the<strong> Request Quote tab</strong>. A member of our team will follow up with you to discuss your requirements and provide further details.</p>
    </div>

    <div class="coatings-grid">
      {coatings.map(coating => (
        <CoatingTile
          title={coating.title}
          image={coating.image}
          description={coating.description}
          link={coating.link}
        />
      ))}
    </div>
  </section>

  <section class="custom-coatings">
    <div class="custom-coatings-inner">
      <h2>Custom Coating Services</h2>
      <p>
        Need something that isn't in our standard portfolio? ZeCoat's motion-controlled
        vacuum deposition system lets us engineer coatings to your exact reflectance,
        durability, and wavelength requirements on substrates up to 2 meters in diameter.
        If we don't already make it, we can build it for you.
      </p>
      <a href="/contact" class="custom-cta">Request a Custom Coating</a>
    </div>
  </section>

</Layout>

<style>

  .standard-coatings {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 1.5rem;
    padding-bottom: 4rem;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw + 1rem, 60px);
    color: black;
  }

  .section-heading p {
    margin-top: 0.75rem;
    color: #475569;
  }

  .coatings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 2rem;
  }

  /* Custom coating services */
  .custom-coatings {
    background: #DCE2E8;
    padding: 4rem 1.5rem;
  }

  .custom-coatings-inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    color: #16202E;
  }

  .custom-coatings-inner h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .custom-coatings-inner p {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .custom-cta {
    display: inline-block;
    background: #E7A21C;
    color: #1B2430;
    font-weight: 600;
    font-size: 1.15rem;
    padding: 0.85rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid #E7A21C;
    box-shadow: 0 8px 24px rgba(235, 189, 37, 0.35);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-cta:hover {
    background: #C6870F;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(235, 189, 37, 0.35);
  }

  /* Inquiry form */
  .inquiry-section {
    padding: 4rem 1.5rem;
    scroll-margin-top: 2rem;
  }
</style>
