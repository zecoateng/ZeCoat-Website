import Layout from "../layouts/layout.astro"


var defl, filmThick;

const stressCalculator = () => {

	Es = +document.getElementById("yMod").value * 1000000000;

	v = +document.getElementById("pRat").value;

	ts = +document.getElementById("subThick").value * .001;

	w = +document.getElementById("subWidth").value * .001;

	defl = +document.getElementById("defl").value * .000001;

	filmThick = +document.getElementById("filmThick").value * .000001;

	stress = Math.round(Es*ts*ts/3/(1-v) * defl/filmThick/(filmThick*filmThick+w*w/4) *.000001);

	document.getElementById("stress").innerHTML = "Stress: " + stress +" MPa";

    };

    

let CSVdata = null;

function circleOverlap(d, R, r) {
  if (d >= R + r) return 0;
  if (d <= Math.abs(R - r)) return Math.PI * Math.min(R, r) ** 2;

  const part1 = R * R * Math.acos((d*d + R*R - r*r) / (2*d*R));
  const part2 = r * r * Math.acos((d*d + r*r - R*R) / (2*d*r));
  const part3 = 0.5 * Math.sqrt(
    (-d + R + r) *
    ( d + R - r) *
    ( d - R + r) *
    ( d + R + r)
  );
  return part1 + part2 - part3;
}

function parseTXT(text) {
  const lines = text.trim().split(/\r?\n/);
  let wavelength = [];
  let refl = [];

  lines.forEach(line => {
    const cols = line.trim().split(/\s+/).map(Number);
    if (cols.length === 2) {
      wavelength.push(cols[0]);
      refl.push(cols[1]);
    } else if (cols.length === 1) {
      refl.push(cols[0]);
    }
  });

  if (wavelength.length === 0) {
    wavelength = Array.from({length: refl.length}, (_, i) => 300 + i);
  }

  return { wavelength, refl };
}

async function loadFile(fileInput) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(parseTXT(reader.result));
    reader.onerror = reject;
    reader.readAsText(fileInput.files[0]);
  });
}

function generateFileInputs() {
  const container = document.getElementById("fileContainer");
  container.innerHTML = "";

  const nAnnuli = parseInt(document.getElementById("nAnnuli").value);

  for (let i = 0; i < nAnnuli; i++) {
    const input = document.createElement("input");
    input.type = "file";
    input.id = "file" + i;
    container.appendChild(input);
    container.appendChild(document.createElement("br"));
  }
}

async function runCalculation() {
  const mirrorD = parseFloat(document.getElementById('mirrorD').value);
  const beamD = parseFloat(document.getElementById('beamD').value);

  const Rm = mirrorD / 2;
  const Rb = beamD / 2;
  const maxCenter = Rm - Rb;
  const nAnnuli = parseInt(document.getElementById("nAnnuli").value);

  const annulusEdges = [];
  for (let i = 0; i <= nAnnuli; i++) {
    annulusEdges.push(i * Rm / nAnnuli);
  }


  let annuli = [];
  for (let i = 0; i < nAnnuli; i++) {
    const input = document.getElementById('file' + i);
    if (!input.files.length) {
      alert('Please upload all five annulus files.');
      return;
    }
    annuli.push(await loadFile(input));
  }

  const wavelength = annuli[0].wavelength;
  const nLambda = wavelength.length;
  const Abeam = Math.PI * Rb * Rb;

  const nRadial = 300;
  let Rmin = Array(nLambda).fill(Infinity);
  let Rmax = Array(nLambda).fill(-Infinity);

  for (let j = 0; j < nRadial; j++) {

    const d = maxCenter * j / (nRadial - 1);

    let Ai = [];
    for (let k = 0; k < nAnnuli; k++) {
      const Aout = circleOverlap(d, Rb, annulusEdges[k+1]);
      const Ain  = circleOverlap(d, Rb, annulusEdges[k]);
      Ai.push(Aout - Ain);
    }

    // Loop over wavelengths
    for (let l = 0; l < nLambda; l++) {

      let RbAvg = 0;

      for (let k = 0; k < nAnnuli; k++) {
        RbAvg += Ai[k] * annuli[k].refl[l];
      }

      RbAvg /= Abeam;

      Rmin[l] = Math.min(Rmin[l], RbAvg);
      Rmax[l] = Math.max(Rmax[l], RbAvg);
    }
  }

  const nMC = 10000;
  let Rmean = Array(nLambda).fill(0);
  for (let i = 0; i < nMC; i++) {

    const d = maxCenter * Math.sqrt(Math.random());

    let Ai = [];
    for (let k = 0; k < nAnnuli; k++) {
      const Aout = circleOverlap(d, Rb, annulusEdges[k+1]);
      const Ain  = circleOverlap(d, Rb, annulusEdges[k]);
      Ai.push(Aout - Ain);
    }
    for (let l = 0; l < nLambda; l++) {

      let RbAvg = 0;

      for (let k = 0; k < nAnnuli; k++) {
        RbAvg += Ai[k] * annuli[k].refl[l];
      }

      Rmean[l] += RbAvg / Abeam;
    }
  }
  for (let l = 0; l < nLambda; l++) {
    Rmean[l] /= nMC;
  }

  let html = '<table><tr><th>λ (nm)</th><th>Min</th><th>Mean</th><th>Max</th></tr>';
  for (let i = 0; i < nLambda; i++) {
    html += `<tr>
      <td>${wavelength[i]}</td>
      <td>${Rmin[i].toFixed(4)}</td>
      <td>${Rmean[i].toFixed(4)}</td>
      <td>${Rmax[i].toFixed(4)}</td>
    </tr>`;
  }
  html += '</table>';

  CSVdata = {
    wavelength,
    Rmin,
    Rmean,
    Rmax
  };

  document.getElementById('csvBtn').disabled = false;

  document.getElementById('output').innerHTML = html;
}

function downloadCSV() {
  if (!CSVdata) return;

  let csv = 'Wavelength_nm,Min_Reflectance,Mean_Reflectance,Max_Reflectance\n';

  for (let i = 0; i < CSVdata.wavelength.length; i++) {
    csv += `${CSVdata.wavelength[i]},` +
           `${CSVdata.Rmin[i]},` +
           `${CSVdata.Rmean[i]},` +
           `${CSVdata.Rmax[i]}\n`;
  }

  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);

  const a = document.createElement('a');
  a.href = url;
  a.download = 'beam_averaged_reflectance.csv';
  document.body.appendChild(a);
  a.click();

  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}


