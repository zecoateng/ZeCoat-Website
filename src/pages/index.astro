---
import Layout from '../layouts/layout.astro'
import Cards from '../components/HomeCards.astro'

const capabilitiesLayout = [
    {
        imgSrc: "/dock-layout.png",
        cardTitle: "Meter-class Mirror Coatings",
        cardBody: "ZeCoat specializes in durable, space-qualified coatings for satellite systems, as well as ground-based observatory coatings."

    },
     {
        imgSrc: "/dock-layout.png",
        cardTitle: "Research & Development",
        cardBody: "ZeCoat has advanced the field of thin film optical coatings through multiple  NASA research grants awarded over the past 25-years. ZeCoat also offers R&D services on a time-and-materials basis."

    },
     {
        imgSrc: "/dock-layout.png",
        cardTitle: "Licensing Technology",
        cardBody: "ZeCoat has over a dozen coating technologies available for sale or license, covering a wide variety of aerospace applications."
    }
]

const experiencesLayout = [
    {
        imgSrc: "/nasa-svgrepo-com.svg",
        cardTitle: "NASA-BACKED missions",
        cardBody: "Flight-proven coatings on NASA missions."

    },
    {
        imgSrc: "/calendar-xmark-alt-svgrepo-com.svg",
        cardTitle: "25+ Years Of fdfd",
        cardBody: "Precision vacuum-deposition experience."

    },
    {
        imgSrc: "/building-svgrepo-com.svg",
        cardTitle: "U.S Based Facility",
        cardBody: "Clean-room in Granite City, Illinois."

    },
    {
        imgSrc: "/itar-registered.svg",
        cardTitle: "ITAR Registered",
        cardBody: "Compliant for defense & aerospace work."

    },
    {
        imgSrc: "/shield-check-svgrepo-com.svg",
        cardTitle: "NASA-BACKED missions",
        cardBody: "Qualified for the harshest space environments."

    }
]

const featuredMissions = [
    {
        imgSrc: "/satelite-image.jpg",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Helped unlock the mysteries of distant worlds"
    },
    {
        imgSrc: "/satelite-image.jpg",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Helped unlock the mysteries of distant worlds"
    },
    {
        imgSrc: "/satelite-image.jpg",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Helped unlock the mysteries of distant worlds"
    },
    {
        imgSrc: "/satelite-image.jpg",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Helped unlock the mysteries of distant worlds"
    }
]

const featuredTechnologies = [
    {
        imgSrc: "/satelite-image.jpg",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Helped unlock the mysteries of distant worlds"
    },
    {
        imgSrc: "/satelite-image.jpg",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Helped unlock the mysteries of distant worlds"
    }
]
---

<Layout>
<section class = "intro-section">
<div class = "title">
<h1 class = "title-header">Optical Coatings Built for Space</h1>
<h3 class = "title-description">ZeCoat delivers space-qualified mirror coatings, NASA-backed R&D services, and licensable aerospace technologies from a clean-room facility in Granite City, IL</h3>

<div class = "hero-buttons">
    <a href="#featured-technologies" class = "btn btn-primary">
        Explore Our Work
    </a>
    <a href="/contact" class = "btn btn-secondary">Contact Us
    </a>
</div>
</div>
</section>
<section id = "what-we-do" class = "what-we-do-section">
<h1>What We Do</h1>
<h3 class = "what-we-do-description">Three core capabilities all built on the same precision vacuum deposition process</h3>
<div class = "cards-layout">
{
    capabilitiesLayout.map(capabilities => {
        return (
            <Cards
            imgSrc = {capabilities.imgSrc}
            cardTitle = {capabilities.cardTitle}
            cardBody = {capabilities.cardBody}/>

        )
    })
}

</div>
</section>
<section class = "experience-section">
    <div class = "featured-header">
<h1>Featured Missions</h1>
<a href="/about">View all Missions</a>
    </div>

<div class = "cards-layout missions">
{
    featuredMissions.map(technologies => {
        return (
            <Cards
            variant = "featured"
            imgSrc = {technologies.imgSrc}
            cardTitle = {technologies.cardTitle}
            cardBody = {technologies.cardBody}/>

        )
    })
}

</div>
<div id = "featured-technologies" class = "featured-header">
<h1>Featured Technologies</h1>
<a href="/technologies">View all Technologies</a>
</div>

<div class = "cards-layout">
{
    featuredTechnologies.map(experiences => {
        return (
            <Cards
            variant = "featured"
            imgSrc = {experiences.imgSrc}
            cardTitle = {experiences.cardTitle}
            cardBody = {experiences.cardBody}/>

        )
    })
}

</div>
</section>

<section class = "why-zecoat">
<div class = "about-tag">
<h3 class = "about-title">Why ZeCoat</h3>
<h1>Proven Experience. Trusted Performance</h1>
    <div class = "cards-layout">
{
    experiencesLayout.map(experiences => {
        return (
            <Cards
            variant = "experiences"
            imgSrc = {experiences.imgSrc}
            cardTitle = {experiences.cardTitle}
            cardBody = {experiences.cardBody}/>

        )
    })
}

</div>
</div>

</section>

</Layout>

<style>
.intro-section {
    width: 100%;
    height: 600px;
    padding-top: 1px;
    position: relative;
}

.intro-section::before {
    content: "";
    position: absolute;
    inset: 0;
     background:
        linear-gradient(
            rgba(5,15,35,.65),
            rgba(5,15,35,.45)
        ),
        url("/dock-layout.png");
    background-size: cover;
    background-position: center;
}

.title {
    width: fit-content;
    padding-left: clamp(2px,4vw,150px);
    position: relative; 
    z-index: 1;
    color: white;
    
}

.title-header {
    font-size: clamp(40px, 4vw, 64px);
    max-width: 700px;
}

.title-description {
    max-width: 500px;
}


.what-we-do-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap:0;
}

.cards-layout {
    margin-top: 60px;
    display: flex;
    justify-content: space-evenly;
    gap: clamp(5px, 4vw, 300px);
    margin-inline: 20px;
}

.experience-section {
    margin-inline: 20px;
}


.what-we-do-section h1 ,
.what-we-do-section h3 {
    margin: 0;
}

.what-we-do-description {
    text-align: center;
}

.about-tag {
    background:#DCE2E8;
    width: 100%;
    text-align: center;
    color: #16202E;

}

.featured-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%
}

.featured-header, .cards-layout {
    width: 100%;
    margin-inline: auto;
    max-width: 1600px;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
}

.btn {
    font: inherit;
    font-size: 1.3rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
}

.btn:active {
    transform: translateY(0);
}

.btn-primary {
    background: #E7A21C;
    color: #1B2430;
    border: 1px solid #E7A21C;
    box-shadow: 0 8px 24px rgba(235, 189, 37, 0.35);
}

.btn-primary:hover {
    background: #C6870F;
    box-shadow: 0 12px 28px rgba(235, 189, 37, 0.356);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(4px);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.6);
}

/* Keyboard accessibility */
.btn:focus-visible {
    outline: 2px solid #93C5FD;
    outline-offset: 2px;
}

a {
    text-decoration: none;
    color: #16202E;
    transition: transform 0.3s ease;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition: border-color .15s;
}

a .arrow { 
    color: #C6870F; 
}   

a:hover { 
    border-color: #E7A21C; 
}    

a:hover .arrow {
     transform: translateX(3px); 
}

a::after {
    content: "";
        position: absolute;

        left: 0;
        bottom: -4px;

        width: 100%;
        height: 1px;

        background: #1B2430;

        transform: scaleX(0);
        transform-origin: left;

        transition: transform 0.3s ease;
}

.about-title {
    color:#C6870F;
    padding-top: 20px;
}

@media (max-width: 768px) {

    /* Hero */
    .intro-section {
        height: auto;
        min-height: 500px;
        display: flex;
        align-items: center;
        padding: 3rem 1.5rem;
    }

    .title {
        padding: 0;
        width: 100%;
        text-align: center;
    }

    .title-header {
        font-size: 2.5rem;
        line-height: 1.2;
        max-width: 100%;
    }

    .title-description {
        max-width: 100%;
        margin: 1rem auto;
        font-size: 1rem;
        line-height: 1.6;
    }

    .missions {
    margin-bottom: 4rem;
}


    /* Hero Buttons */

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
        width: 100%;
    }

    .btn {
        text-align: center;
        width: 100%;
    }

    /* Section spacing */

    .what-we-do-section,
    .experience-section {
        padding: 3rem 1rem;
    }

    /* Cards */

    .cards-layout {
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-top: 2rem;
    }

    /* Assuming cards have a fixed width */

    .cards-layout > * {
        width: 100%;
        max-width: 380px;
    }

    /* Featured headers */

    .featured-header {
        flex-direction: column;
        align-items: flex-start;
        gap: .75rem;
    }

    .featured-header h1 {
        margin: 0;
    }

    /* About section */

    /* Headings */

    h1 {
        font-size: 2rem;
    }

    h2 {
        font-size: 1.6rem;
    }

    h3 {
        font-size: 1rem;
    }

}

</style>

