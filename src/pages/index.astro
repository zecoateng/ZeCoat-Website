---
import Layout from '../layouts/layout.astro'
import Cards from '../components/HomeCards.astro'

const capabilitiesLayout = [
    {
        imgSrc: "/MirrorImage.webp",
        cardTitle: "Meter-class Mirror Coatings",
        cardBody: "ZeCoat specializes in durable, space-qualified coatings for satellite systems, as well as ground-based observatory coatings.",
        back: "More details coming soon."

    },
     {
        imgSrc: "/chamber.webp",
        cardTitle: "Research & Development",
        cardBody: "ZeCoat has advanced the field of thin film optical coatings through multiple  NASA research grants awarded over the past 25-years. ZeCoat also offers R&D services on a time-and-materials basis.",
        back: "More details coming soon."

    },
     {
        imgSrc: "/ProductionCoating.webp",
        cardTitle: "Production-Scale Coating",
        cardBody: "ZeCoat offers production-ready coating capabilites, accommodating parts and batches within a coating area of up to two meters, with lead times as short as 4-12 weeks.",
        back: "More details coming soon."
    }
]

const experiencesLayout = [
    {
        imgSrc: "/calendar-xmark-alt-svgrepo-com.svg",
        cardTitle: "15+ Years Experience",
        cardBody: "Precision vacuum-deposition experience"

    },
    {
        imgSrc: "/building-svgrepo-com.svg",
        cardTitle: "U.S. Based Facility",
        cardBody: "Manufacturing facility in Granite City, Illinois"

    },
    {
        imgSrc: "/itar-registered.svg",
        cardTitle: "ITAR Registered",
        cardBody: "Compliant for defense & aerospace work"

    },
    {
        imgSrc: "/shield-check-svgrepo-com.svg",
        cardTitle: "U.S. DOW Government Contractor",
        cardBody: "CMMC compliant for prime and subcontracting"
    }
]

const featuredMissions = [
    {
        imgSrc: "/Kepler-Space-Telescope.webp",
        cardTitle: "Kepler Space Telescope",
        cardBody: "Developed protected silver coating on the primary mirror of NASA's Kepler Space Telescope."
    },
    {
        imgSrc: "/Mars-Insight-Lander.webp",
        cardTitle: "Mars InSight",
        cardBody: "Designed the thermal control coating protecting the SEIS seismometer on NASA's Mars InSight Lander from extreme Martian temperatures."
    },
    {
        imgSrc: "/HWOImage.webp",
        cardTitle: "Upcoming: Habitable Worlds Observatory",
        cardBody: "Leading development of next-generation FUV broadband reflective coatings for NASA's Habitable Worlds Observatory."
    }
]

const featuredTechnologies = [
    {
        imgSrc: "/MicrometeroidImage.webp",
        cardTitle: "Micrometeroid Protection",
        cardBody: "More details coming soon..."
    },
    {
        imgSrc: "/SelfCoatingTelescope.webp",
        cardTitle: "Self-Coating Telescope",
        cardBody: "ZeCoat's self-coating telescope re-coats its own mirror in orbit with fresh aluminum, reaching deeper into the ultraviolet than ground-coated optics can."
    },
    {
        imgSrc: "/EnhancedProtectiveSilver.webp",
        cardTitle: "FUV Aluminum",
        cardBody: "More details coming soon..."
    }
]

---

<Layout>
<section class = "intro-section">
<div class = "title">
<h1 class = "title-header">Optical Coatings Engineered for Space</h1>
<h3 class = "title-description">ZeCoat delivers space-qualified mirror coatings, NASA-funded R&D, and licensable aerospace technologies from our cleanroom facility in Granite City, IL</h3>

<div class = "hero-buttons">
    <a href="/technologies" class = "btn btn-primary">
        Explore Our Work
    </a>
    <a href="/contact" class = "btn btn-secondary">Contact Us
    </a>
</div>
</div>
</section>
<div class = "page-layout">
<section id = "what-we-do" class = "what-we-do-section">
<h1>What We Do</h1>
<h3 class = "what-we-do-description">Three core capabilities all built on the same precision vacuum deposition process</h3>
<div class = "cards-layout">
{
    capabilitiesLayout.map(capabilities => {
        return (
            <Cards
            variant = "flip"
            imgSrc = {capabilities.imgSrc}
            cardTitle = {capabilities.cardTitle}
            cardBody = {capabilities.cardBody}
            back = {capabilities.back}/>

        )
    })
}

</div>
</section>
<section class = "announcements-section">
<h1>Announcements</h1>

    <div class="cards-layout" id="announcements-list">
        <p class="announcement-empty">Loading announcements…</p>
    </div>

</section>
<section class = "experience-section">
    <div class = "featuredMissions-section">

    
<div class = "featured-header">
<h1>Featured Missions</h1>
<a href="/about">View all Missions</a>
    </div>

<div class = "cards-layout missions">
{
    featuredMissions.map(technologies => {
        return (
            <Cards
            variant = "featured"
            imgSrc = {technologies.imgSrc}
            cardTitle = {technologies.cardTitle}
            cardBody = {technologies.cardBody}/>

        )
    })
}

</div>
</div>
<div class = "featuredTechnologies-section">
<div id = "featured-technologies" class = "featured-header">
<h1>Featured Technologies</h1>
<a href="/technologies">View all Technologies</a>
</div>

<div class = "cards-layout">
{
    featuredTechnologies.map(experiences => {
        return (
            <Cards
            variant = "featured"
            imgSrc = {experiences.imgSrc}
            cardTitle = {experiences.cardTitle}
            cardBody = {experiences.cardBody}/>

        )
    })
}

</div>
</div>
</section>

<section class = "why-zecoat">
<div class = "about-tag">
<h3 class = "about-title">Why ZeCoat</h3>
<h1>Proven Experience. Trusted Performance</h1>
    <div class = "cards-layout">
{
    experiencesLayout.map(experiences => {
        return (
            <Cards
            variant = "experiences"
            imgSrc = {experiences.imgSrc}
            cardTitle = {experiences.cardTitle}
            cardBody = {experiences.cardBody}/>

        )
    })
}

</div>
</div>

</section>
</div>

</Layout>

<script>
  // Escape user-entered text so a title/description can't inject HTML
  const esc = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c])
    );

  async function loadAnnouncements() {
    // Re-query each run: ClientRouter swaps in a fresh DOM on every navigation
    const list = document.getElementById("announcements-list");
    if (!list) return;
    try {
      const res = await fetch("/api/announcements");
      if (!res.ok) throw new Error(`Request failed: ${res.status}`);

      const data = await res.json();
      const announcements = Array.isArray(data) ? data : [];

      if (announcements.length === 0) {
        list.innerHTML = `<p class="announcement-empty">No announcements yet.</p>`;
        return;
      }

      list.innerHTML = announcements
        .map(
          (a) => `
        <div class="announcement-card">
          <span class="announcement-date">${esc(new Date(a.date).toLocaleDateString())}</span>
          <h3 class="announcement-title">${esc(a.title)}</h3>
          <p class="announcement-body">${esc(a.description)}</p>
        </div>`
        )
        .join("");
    } catch (err) {
      console.error("Could not load announcements:", err);
      list.innerHTML = `<p class="announcement-empty">Couldn't load announcements right now.</p>`;
    }
  }

  // ClientRouter navigates without a full page reload, so run on every Astro
  // page load — this fires on the initial load AND after each client-side nav.
  document.addEventListener("astro:page-load", loadAnnouncements);
</script>

<style>
.intro-section {
    width: 100%;
    height: 600px;
    padding-top: 1px;
    position: relative;
}

.intro-section::before {
    content: "";
    position: absolute;
    inset: 0;
     background:
        linear-gradient(
            rgba(5,15,35,.65),
            rgba(5,15,35,.45)
        ),
        url("/HeroImage.webp");
    background-size: cover;
    background-position: center;
}

.title {
    width: fit-content;
    padding-left: clamp(2px,4vw,150px);
    position: relative; 
    z-index: 1;
    color: white;
    
}

.title-header {
    font-size: clamp(40px, 4vw, 64px);
    max-width: 700px;
}

.title-description {
    max-width: 500px;
}


.what-we-do-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap:0;
    margin-inline: 20px;
}

.cards-layout {
    margin-top: 60px;
    display: flex;
    justify-content: space-evenly;
    gap: clamp(1rem, 4vw, 4rem);
    margin-inline: 20px;
}

.cards-layout > * {
    flex: 1 1 0;
    min-width: 0;
}

.experience-section {
    margin-inline: 20px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
    
}


.what-we-do-section h1 ,
.what-we-do-section h3 {
    margin: 0;
}

.what-we-do-description {
    text-align: center;
    font-weight: 400;
    color: #475569;
}

.about-tag {
    background:#DCE2E8;
    width: 100%;
    text-align: center;
    color: #16202E;

}

.featured-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%
}

.featured-header, .cards-layout {
    width: 100%;
    margin-inline: auto;
    max-width: 1600px;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
}

.btn {
    font: inherit;
    font-size: 1.3rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
}

.btn:active {
    transform: translateY(0);
}

.btn-primary {
    background: #E7A21C;
    color: #1B2430;
    border: 1px solid #E7A21C;
    box-shadow: 0 8px 24px rgba(235, 189, 37, 0.35);
}

.btn-primary:hover {
    background: #C6870F;
    box-shadow: 0 12px 28px rgba(235, 189, 37, 0.356);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(4px);
}

.btn-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.6);
}

/* Keyboard accessibility */
.btn:focus-visible {
    outline: 2px solid #93C5FD;
    outline-offset: 2px;
}

a {
    text-decoration: none;
    color: #16202E;
    transition: transform 0.3s ease;
    border-bottom: 2px solid transparent;
    padding-bottom: 2px;
    transition: border-color .15s;
}

a .arrow { 
    color: #C6870F; 
}   

a:hover { 
    border-color: #E7A21C; 
}    

a:hover .arrow {
     transform: translateX(3px); 
}

a::after {
    content: "";
        position: absolute;

        left: 0;
        bottom: -4px;

        width: 100%;
        height: 1px;

        background: #1B2430;

        transform: scaleX(0);
        transform-origin: left;

        transition: transform 0.3s ease;
}

.about-title {
    color:#C6870F;
    padding-top: 20px;
}

.announcements-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-inline: 20px;
}

.announcements-section h1 {
    margin: 0;
}

.announcements-description {
    margin: 0;
    text-align: center;
}

:global(.announcement-card) {
    flex: 1;
    max-width: 380px;
    padding: 1.5rem;
    border: 1px solid #DCE2E8;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 4px 12px rgba(22, 32, 46, 0.06);
}

:global(.announcement-date) {
    font-size: 0.85rem;
    font-weight: 600;
    color: #C6870F;
}

:global(.announcement-title) {
    margin: 0.5rem 0;
    color: #16202E;
}

:global(.announcement-body) {
    margin: 0;
    color: #1B2430;
    line-height: 1.5;
}

:global(.announcement-empty) {
    margin-top: 60px;
    color: #64748B;
    text-align: center;
}

.page-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

@media (max-width: 768px) {

    /* Hero */
    .intro-section {
        height: auto;
        min-height: 500px;
        display: flex;
        align-items: center;
        padding: 3rem 1.5rem;
    }

    .title {
        padding: 0;
        width: 100%;
        text-align: center;
    }

    .title-header {
        font-size: 2.5rem;
        line-height: 1.2;
        max-width: 100%;
    }

    .title-description {
        max-width: 100%;
        margin: 1rem auto;
        font-size: 1rem;
        line-height: 1.6;
    }

    .missions {
    margin-bottom: 4rem;
}


    /* Hero Buttons */

    .hero-buttons {
        flex-direction: column;
        align-items: stretch;
        width: 100%;
    }

    .btn {
        text-align: center;
        width: 100%;
    }

    /* Section spacing */

    .what-we-do-section,
    .experience-section {
        padding: 3rem 1rem;
    }

    /* Cards */

    .cards-layout {
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        margin-top: 2rem;

    }

    /* Assuming cards have a fixed width */

    .cards-layout > * {
        width: 100%;
        max-width: 380px;
    }

    /* Featured headers */

    .featured-header {
        flex-direction: column;
        align-items: flex-start;
        gap: .75rem;
    }

    .featured-header h1 {
        margin: 0;
    }

    /* About section */

    /* Headings */

    h1 {
        font-size: 2rem;
    }

    h2 {
        font-size: 1.6rem;
    }

    h3 {
        font-size: 1rem;
    }

}

</style>

