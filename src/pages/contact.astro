---
import Layout from '../layouts/layout.astro'
---

<Layout>
<div class = "forms-page">
<div class = "inquiries-statement">
<h1>Get in touch.</h1>
<h3>We welcome you inquiries.  If you would like more information about our custom or off-the-shelf coatings or to request a quote, please email us. If possible, when requesting a quote, please include your technical specifications, quantity and size of the substrates you will be providing, if the mirrors will all come at one time, and when you would like the mirror coated by. 
</h3>
<h3>Your request will be reviewed by the Chief Technical Officer, David Sheikh. </h3>
</div>
<form class = "forms-list" action="/api/contact" method="POST"> <!--this is where the form would be submitted -->

<p>FORMS LIST</p>
<div class = "name">
<input type="text" placeholder="First Name">
<input type="text" placeholder="Last Name">
</div>
<input type="text" placeholder="Company">
<input type="text" placeholder="Email">
<input type="text" placeholder="Phone-Number">
<textarea placeholder="Additional Comments"></textarea>
<button>Submit</button>
</form>
<div>
</div>

</div>
</Layout>

<style>

.forms-page {
    display: flex;
    justify-content: center;
}

.inquiries-statement {
    max-width: 700px;
    width: 100%;
}

.forms-list {
    display: flex;
    flex-direction: column;
    margin: 2rem;
}

.name {
    display: flex;
    gap: 1rem;
}

.name input {
    flex: 1;
}

</style>
