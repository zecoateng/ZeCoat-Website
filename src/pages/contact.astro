---
import Layout from '../layouts/layout.astro'
---

<Layout>
<div class = "forms-page">
<div class = "inquiries-statement">
<h1>Get in Touch</h1>
<h3>We welcome your inquiries.  If you would like more information about our custom or off-the-shelf coatings or to request a quote, please fill out this form or email us directly. If possible, please include your technical specifications, quantity and size of the substrates you will be providing, if the mirrors will all come at one time, and when you would like the mirror coated by. 
</h3>
<h3>Your request will be reviewed by our office and we will get back to you within 1-2 business days.</h3>
</div>
<form class = "forms-list" action="/api/contact" method="POST"> <!--this is where the form would be submitted -->

<div class = "name">
<input type="text" placeholder="First Name">
<input type="text" placeholder="Last Name">
</div>
<input type="text" placeholder="Company">
<input type="text" placeholder="Email">
<input type="text" placeholder="Phone-Number">
<textarea placeholder="Reason for Contact"></textarea>
<button>Submit</button>
</form>
<div>
</div>

</div>
</Layout>

<style>

.forms-page {
    display: flex;
    justify-content: center;
}

.inquiries-statement {
    max-width: 700px;
    width: 100%;
    margin-left: 2rem;
}

.inquiries-statement h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
}

.inquiries-statement h3 {
    font-size: clamp(0.9rem, 1.5vw, 1.2rem);
    line-height: 1.7;
    font-weight: 400;
}

.forms-list {
    display: flex;
    flex-direction: column;
    margin: 2rem;
    gap: 1.25rem;
    margin: 2rem;
    background: white;
    padding: 2rem;
    border-radius: 14px;

    box-shadow:
        0 12px 40px rgba(15,23,42,.08);

    width: 500px;
}

.forms-list input,
.forms-list textarea {

    padding: 1rem;

    border: 1px solid #D8DEE6;

    border-radius: 8px;

    font-size: 1rem;

    transition: .2s;
}

.forms-list input:focus,
.forms-list textarea:focus{

    outline: none;

    border-color: #2563eb;

    box-shadow: 0 0 0 4px rgba(37,99,235,.15);
}

button {

    background:#1E293B;
    color:white;

    border:none;

    padding:1rem;

    border-radius:8px;

    cursor:pointer;

    font-weight:600;

    transition:.25s;
}

button:hover{

    background:#334155;
}

.name {
    display: flex;
    gap: 1rem;
}

.name input {
    flex: 1;
    min-width: 0;
}

@media (max-width: 900px) {

    .forms-page {
        flex-direction: column;
        align-items: center;
    }

    .inquiries-statement {
        margin-left: 0;
    }

    .forms-list {
        width: 100%;
        max-width: 500px;
    }

}

</style>
