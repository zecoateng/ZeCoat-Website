---
import Layout from '../../layouts/layout.astro';
import CoatingTile from '../../components/CoatingTile.astro';
---

<Layout>
  <div class="page-layout">
    <div class="back-link">
      <a href="/coatings">&larr; Back to Coatings</a>
    </div>
    <div class="page-header">
      <h1>Roll to Roll</h1>
      <p>ZeCoat's roll-to-roll coating system applies uniform, scalable coatings to large, flexible membranes and films, extending our optical and protective coatings to continuous, large-area formats that don't fit inside a conventional chamber.</p>
    </div>

    <div class="variant-grid">
      <CoatingTile
        title="Optical Solar Reflector"
        image="/RolltoRollCoating.webp"
        description="Roll-to-roll optical solar reflector coating for thermal control on large flexible structures."
        link="/coatings/roll-to-roll/optical-solar-reflector"
      />
      <CoatingTile
        title="Low Emissivity Coating"
        image="/RolltoRollCoating.webp"
        description="Roll-to-roll low-emissivity coating for thermal insulation on large flexible structures."
        link="/coatings/roll-to-roll/low-emissivity-coating"
      />
      <CoatingTile
        title="Multi-Layer Interference"
        image="/RolltoRollCoating.webp"
        description="Roll-to-roll multi-layer interference coating."
        link="/coatings/roll-to-roll/multi-layer-interference"
      />
      <CoatingTile
        title="Black Coating"
        image="/BlackCoating.webp"
        description="Roll-to-roll black coating for stray-light suppression on large flexible structures."
        link="/coatings/roll-to-roll/black-coating"
      />
      <CoatingTile
        title="Micrometeorite Protected"
        image="/MicrometeroidImage.webp"
        description="Roll-to-roll coating architecture combining micrometeoroid shielding with thermal and optical control."
        link="/coatings/roll-to-roll/micrometeorite-protected"
      />
    </div>

    <div class="quote-cta">
      <a href="/contact">Request a Quote</a>
    </div>
  </div>
</Layout>

<style>

.page-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
    padding: 1.5rem;
}

.back-link {
    align-self: flex-start;
    width: 100%;
    max-width: 1100px;
    margin: 10px auto 0;
}

.back-link a {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
}

.back-link a:hover {
    text-decoration: underline;
}

.page-header {
    text-align: center;
    width: 100%;
    max-width: 800px;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
}

.page-header h1 {
    font-size: clamp(2rem, 4vw + 1rem, 60px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: black;
}

.page-header p {
    color: #475569;
    line-height: 1.7;
}

.variant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 360px));
    justify-content: center;
    gap: 2rem;
    width: 100%;
    max-width: 1100px;
}

.quote-cta {
    margin-top: 3rem;
    text-align: center;
}

.quote-cta a {
    display: inline-block;
    background: #E7A21C;
    color: #1B2430;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.85rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid #E7A21C;
    box-shadow: 0 8px 24px rgba(235, 189, 37, 0.35);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.quote-cta a:hover {
    background: #C6870F;
    transform: translateY(-2px);
}

@media (max-width: 600px) {
    .page-header h1 {
        font-size: 2rem;
    }

    .page-header p {
        font-size: 1rem;
        line-height: 1.6;
    }
}

</style>