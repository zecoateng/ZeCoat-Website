---
import Layout from '../../../layouts/layout.astro';
import CoatingDetail from '../../../components/CoatingDetail.astro';

const specs = [];

const bands = [
        { band: "350-400 nm", avg: "91.0%", max: "", min: "89.0%" },
        { band: "400-450 nm", avg: "96.0%", max: "", min: "94.0%" },
        { band: "450-500 nm", avg: "96.0%", max: "", min: "94.0%" },
        { band: "500-550 nm", avg: "95.5%", max: "", min: "93.5%" },
        { band: "550-600 nm", avg: "95.0%", max: "", min: "93.0%" },
        { band: "600-650 nm", avg: "95.0%", max: "", min: "93.0%" },
        { band: "650-700 nm", avg: "94.5%", max: "", min: "92.0%" },
        { band: "700-750 nm", avg: "94.0%", max: "", min: "92.0%" },
        { band: "750-800 nm", avg: "94.0%", max: "", min: "92.0%" },
        { band: "800-850 nm", avg: "94.0%", max: "", min: "92.0%" },
        { band: "850-900 nm", avg: "94.0%", max: "", min: "92.0%" },
        { band: "900-950 nm", avg: "94.5%", max: "", min: "92.0%" },
        { band: "950-1000 nm", avg: "95.0%", max: "", min: "93.0%" },
        { band: "1000-1500 nm", avg: "97.0%", max: "", min: "95.0%" },
        { band: "1500-2000 nm", avg: "98.0%", max: "", min: "96.0%" },
        { band: "2000-5000 nm", avg: "98.0%", max: "", min: "96.0%" },
        { band: "5000-10000 nm", avg: "98.0%", max: "", min: "96.0%" },
        { band: "10000-15000 nm", avg: "98.0%", max: "", min: "96.0%" }
      ];

const durability = [
        { test: "Adhesion", spec: "ISO-9211-4, MIL-PRF-13830B", description: "Slow-pull, 90-deg" },
        { test: "Abrasion", spec: "ISO-9211-4, MIL-PRF-13830B", description: "Moderate cheesecloth, 50 strokes" },
        { test: "Physical Cosmetic", spec: "MIL-C-48497A 4.5.2.1", description: "Visual" },
        { test: "Environmental Physical", spec: "MIL-C-48497A C.4.5.8", description: "Visual" },
        { test: "24-hr Humidity", spec: "MIL-PRF-13830B C.4.5.8", description: "50C/95%/24-hr" },
        { test: "DI Water Solubility", spec: "ISO-9211 4-8-04", description: "24-hr" },
        { test: "Salt Water Solubility", spec: "ISO-9211 4-8-04", description: "24-hr" },
        { test: "Acid Corrosion", spec: "MIL-STD-810G method 518.1", description: "Atomized pH = 4.0, 48-hr" },
        { test: "H2S", spec: "ZC-M-F-900A", description: "24-hr" },
        { test: "96H Salt-Controlled Humidity", spec: "ZeCoat Modified 13830B", description: "24-hr, KCL 80C/80%RH" },
        { test: "Thermal Cycle", spec: "ZeCoat Modified 13830B B.4.4.4", description: "+150 C / -75 C" }
      ];
---

<Layout>
  <CoatingDetail
    linksHeading="Related Links"
    title="ZC-1392"
    familyLabel="Protected Silver"
    familyHref="/coatings/protected-silver"
    image="/ZC1392.webp"
    description="Both ZC-1251 and ZC-1392 are designed to remain undarkened by particle radiation from the solar wind (such as that found in geostationary orbit) and to remain undamaged by atomic oxygen (found in low Earth orbit). ZC-1392 is optimized for the visible and near-infrared band (400 nm to 1000 nm), and has been tested in a simulated GEO environment at NASA GSFC."
    specs={specs}
    bands={bands}
    durability={durability}
    reflectanceNote="* Scans shown are for an 8° angle of incidence (AOI)."
  />
</Layout>
