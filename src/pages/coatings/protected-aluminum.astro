---
import Layout from '../../layouts/layout.astro';
import CoatingTile from '../../components/CoatingTile.astro';
---

<Layout>
  <div class="page-layout">
    <div class="back-link">
      <a href="/coatings">&larr; Back to Coatings</a>
    </div>
    <div class="page-header">
      <h1>Protected Aluminum</h1>
      <p>ZeCoat's protected aluminum coatings provide broadband reflectance from the far-ultraviolet through the infrared, tailored across four variants for different mission needs.</p>
    </div>

    <div class="variant-grid">
      <CoatingTile
        title="Vis-NIR Aluminum (No 850 nm Dip)"
        image="/ProtectedAluminum.webp"
        description="Visible to near-infrared aluminum coating engineered to eliminate the reflectance dip near 850 nm."
        link="/coatings/protected-aluminum/vis-nir"
      />
      <CoatingTile
        title="IR Aluminum for SDL"
        image="/ProtectedAluminum.webp"
        description="Infrared aluminum coating developed for SDL."
        link="/coatings/protected-aluminum/ir-sdl"
      />
      <CoatingTile
        title="FUV Aluminum (Magnesium Fluoride)"
        image="/BPD.webp"
        description="Far-ultraviolet aluminum coating protected with a magnesium fluoride overcoat."
        link="/coatings/protected-aluminum/fuv-mgf2"
      />
      <CoatingTile
        title="HWO FUV Aluminum (Lithium Fluoride)"
        image="/HWOImage.webp"
        description="Far-ultraviolet aluminum coating protected with a lithium fluoride overcoat, developed for the Habitable Worlds Observatory (HWO)."
        link="/coatings/protected-aluminum/fuv-hwo-lif"
      />
    </div>

    <div class="quote-cta">
      <a href="/contact">Request a Quote</a>
    </div>
  </div>
</Layout>

<style>

.page-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40px;
    padding: 1.5rem;
}

.back-link {
    align-self: flex-start;
    width: 100%;
    max-width: 1100px;
    margin: 10px auto 0;
}

.back-link a {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
}

.back-link a:hover {
    text-decoration: underline;
}

.page-header {
    text-align: center;
    width: 100%;
    max-width: 800px;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
}

.page-header h1 {
    font-size: clamp(2rem, 4vw + 1rem, 60px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: black;
}

.page-header p {
    color: #475569;
    line-height: 1.7;
}

.variant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 360px));
    justify-content: center;
    gap: 2rem;
    width: 100%;
    max-width: 1100px;
}

.quote-cta {
    margin-top: 3rem;
    text-align: center;
}

.quote-cta a {
    display: inline-block;
    background: #E7A21C;
    color: #1B2430;
    font-weight: 600;
    font-size: 1.05rem;
    padding: 0.85rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid #E7A21C;
    box-shadow: 0 8px 24px rgba(235, 189, 37, 0.35);
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.quote-cta a:hover {
    background: #C6870F;
    transform: translateY(-2px);
}

@media (max-width: 600px) {
    .page-header h1 {
        font-size: 2rem;
    }

    .page-header p {
        font-size: 1rem;
        line-height: 1.6;
    }
}

</style>