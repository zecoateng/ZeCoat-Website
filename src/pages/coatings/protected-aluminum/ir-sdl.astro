---
import Layout from '../../../layouts/layout.astro';
import CoatingDetail from '../../../components/CoatingDetail.astro';

const specs = [];

const bands = [
  { band: "700-1000 nm", avg: "86%", max: "", min: "82%" },
  { band: "1000-1500 nm", avg: "96%", max: "", min: "93%" },
  { band: "1500-2000 nm", avg: "98%", max: "", min: "97%" },
  { band: "2000-3000 nm", avg: "98%", max: "", min: "97%" },
  { band: "3000-4000 nm", avg: "98%", max: "", min: "98%" },
  { band: "4000-5000 nm", avg: "98%", max: "", min: "98%" },
  { band: "5000-6000 nm", avg: "99%", max: "", min: "99%" },
  { band: "6000-7000 nm", avg: "99%", max: "", min: "99%" },
  { band: "7000-8000 nm", avg: "99%", max: "", min: "99%" },
  { band: "8000-9000 nm", avg: "99%", max: "", min: "98%" },
  { band: "9000-10000 nm", avg: "98%", max: "", min: "98%" },
];

const durability = [
  { test: "Adhesion", spec: "MIL-C-48497A SECT. 3.4.1.1 AND 4.5.3.1", description: "Slow-pull, 90-deg" },
  { test: "Abrasion", spec: "MIL-C-48497A SECT. 3.4.1.3 AND 4.5.3.3", description: "Moderate cheesecloth, 50 strokes" },
  { test: "24-hr Humidity", spec: "MIL-C-48497A SECT. 3.4.1.2 AND 4.5.3.2", description: "50C/95%/24-hr" },
  { test: "Thermal Cycle", spec: "MIL-C-48497A SECT. 3.4.2.1 AND 4.5.4.1", description: "RT to -171°C" },
];

---

<Layout>
  <CoatingDetail
    title="IR Aluminum for SDL"
    familyLabel="Protected Aluminum"
    familyHref="/coatings/protected-aluminum"
    image="/IRAluminumSDLPage.webp"
    description="More detail coming soon."
    specs={specs}
    bands={bands}
    durability={durability}
  />
</Layout>
