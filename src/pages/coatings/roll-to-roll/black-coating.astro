---
import Layout from '../../../layouts/layout.astro';
import CoatingDetail from '../../../components/CoatingDetail.astro';

const specs = [];

const bandGroups = [
  { label: "Batch Coating", bands: [
  { band: "400-450 nm", avg: "1.4%", max: "3.1%", min: "" },
  { band: "450-500 nm", avg: "0.3%", max: "0.7%", min: "" },
  { band: "500-550 nm", avg: "0.2%", max: "0.3%", min: "" },
  { band: "550-600 nm", avg: "0.2%", max: "0.3%", min: "" },
  { band: "600-650 nm", avg: "0.1%", max: "0.3%", min: "" },
  { band: "650-700 nm", avg: "0.1%", max: "0.2%", min: "" },
  { band: "700-750 nm", avg: "0.2%", max: "0.3%", min: "" },
  { band: "750-800 nm", avg: "0.4%", max: "0.7%", min: "" },
  { band: "800-850 nm", avg: "0.8%", max: "1.3%", min: "" },
  { band: "850-900 nm", avg: "1.4%", max: "2.2%", min: "" },
  { band: "900-950 nm", avg: "2.2%", max: "3.2%", min: "" },
  { band: "950-1000 nm", avg: "3.3%", max: "4.5%", min: "" },
] },
  { label: "Roll-to-Roll Coating", bands: [
  { band: "400-450 nm", avg: "1.5%", max: "2.9%", min: "" },
  { band: "450-500 nm", avg: "1.4%", max: "2.1%", min: "" },
  { band: "500-550 nm", avg: "1.3%", max: "2.0%", min: "" },
  { band: "550-600 nm", avg: "1.0%", max: "1.7%", min: "" },
  { band: "600-650 nm", avg: "0.9%", max: "1.2%", min: "" },
  { band: "650-700 nm", avg: "0.9%", max: "1.5%", min: "" },
  { band: "700-750 nm", avg: "1.1%", max: "2.0%", min: "" },
  { band: "750-800 nm", avg: "1.4%", max: "2.5%", min: "" },
] },
];

const durability = [
  { test: "Adhesion", spec: "MIL-PRF-13830B", description: "Slow-pull, 90-deg" },
  { test: "Abrasion", spec: "MIL-PRF-13830B", description: "Moderate cheesecloth, 50 strokes" },
  { test: "24-hr Humidity", spec: "MIL-PRF-13830B", description: "50C/95%/24-hr" },
  { test: "Thermal Cycle", spec: "ZeCoat Modified 13830B B.4.4.4", description: "+74 C / -37 C" },
];

const publications = [
        { title: "Radiation-Hardened Dark Coating for Stray-Light Suppression — MDA SBIR Phase II, 2024", url: "https://www.sbir.gov/awards/209698" },
        { title: "Radiation-Hardened Dark Coating for Stray-Light Suppression — MDA SBIR Phase I, 2022", url: "https://www.sbir.gov/awards/198283" },
        { title: "Dark Coatings with Tailorable BRDF and Thermal Emissivity for Light-Blocking Starshade Membranes — NASA SBIR Phase II, 2021", url: "https://www.sbir.gov/awards/189354" },
        { title: "Specular Black Coating for Flexible Starshade Optical Shield — NASA SBIR Phase I, 2020", url: "https://www.sbir.gov/awards/181931" },
        { title: "Antireflection coatings on starshade light-blocking membranes for straylight suppression", url: "https://proceedings.spiedigitallibrary.org/conference-proceedings-of-spie/12680/126802N/Antireflection-coatings-on-starshade-light-blocking-membranes-for-straylight-suppression/10.1117/12.2692094.full" }
      ];
---

<Layout>
  <CoatingDetail
    title="Black Coating"
    familyLabel="Roll to Roll"
    familyHref="/coatings/roll-to-roll"
    image="/StarshadeMembrane.webp"
    description="Black coating engineered for straylight suppression and contrast control across the visible to infrared spectrum. We optimized the roll-to-roll coating design for the 400–800 nm band; the coating may also be optimized for the UV or longer IR bands. The image shows the roll-to-roll coating."
    specs={specs}
    bandGroups={bandGroups}
    mergeBandGroups={true}
    reflectanceNote="* All measurements are hemispherical reflectance."
    durability={durability}
    publications={publications}
    linksHeading="SBIR Contracts & Publications"
  />
</Layout>
