---
import Layout from '../layouts/layout.astro'
import ProjectCard from '../components/AboutCards.astro'

const timeline = [
  {
    category: "Telescope Coatings",
    title: "Kepler Space Telescope",
    description: "Mr. Sheikh developed the protected silver coating for the primary mirror of NASA's Kepler mission, which was vital for maximizing light reflectivity to discover Earth-sized exoplanets."
  },

  {
    category: "Telescope Coatings",
    title: "Moon Mineralogy Mapper (M³)",
    description: "Mr. Sheikh created the protected silver coatings used on the M³ imaging spectrometer, a NASA instrument carried by India's Chandrayaan-1 spacecraft that helped confirm water molecules on the Moon."
  },

  {
    category: "Spacecraft Accomplishments",
    title: "Mars InSight Seismometer Cover",
    description: "In 2014, the ZeCoat team designed the critical thermal control coating applied to the inner and outer shield of SEIS (the seismometer) on the Mars InSight Lander, protecting the sensitive instrument from intense Martian temperature swings and reducing solar glint."
  },

  {
    category: "Spacecraft Accomplishments",
    title: "NuSTAR Space Telescope",
    description: "Mr. Sheikh developed x-ray transparent optics covers and solar rejection filters to block interfering sunlight while allowing high-energy X-rays to pass through safely."
  },

  {
    category: "Spacecraft Accomplishments",
    title: "NanoSail-D Spacecraft",
    description: "Mr. Sheikh developed a highly reflective aluminum coating deposited directly onto ultra-thin, 2-micron polyimide film for NASA's early solar sail demonstrations."
  },

  {
    category: "Telescope Coatings",
    title: "Far-Ultraviolet (FUV) Broadband Coatings",
    description: "The ZeCoat team designed & manufactured an advanced aluminum-based physical vapor deposition coating. This technique achieved over 90% reflectance in the FUV band at Lyman-alpha."
  },

  {
    category: "Telescope Coatings",
    title: "UV-Enhanced Protected Silver",
    description: "ZeCoat engineered a specialized, exceptionally durable silver mirror coating that maintains high reflectivity from 350 nm through the long-wavelength infrared spectrum. The coating was flown on the OCI instrument aboard NASA's PACE mission."
  },

  {
    category: "Spacecraft Accomplishments",
    title: "ISIS High-altitude Airship",
    description: "Mr. Sheikh developed a roll-to-roll coating process to apply silver to thin polyimide membranes to create the reflective surface on the outside of a high-altitude airship."
  },

  {
    category: "Spacecraft Accomplishments",
    title: "Starshade for Planet Hunting",
    description: "ZeCoat developed a durable, ultra-black coating technology that could significantly improve NASA's ability to directly detect and study Earth-like exoplanets by suppressing unwanted reflected light."
  },

  {
    category: "Telescope Coatings",
    title: "Habitable Worlds Observatory (HWO) Project",
    description: "ZeCoat is currently leading the development of FUV broadband reflective coatings for a NASA D.19 Industrial Partnership program."
  },

  {
    category: "Spacecraft Accomplishments",
    title: "Habitable Worlds Observatory Thermal Films",
    description: "ZeCoat is currently leading the development of multi-layered thermal control films on polymer membranes to insulate and protect next-generation deep-space observatories."
  },

  {
    category: "Active in Space",
    title: "Self-Coating Space Telescopes",
    description: "Under recent NASA contracts, David Sheikh has developed a battery-powered aluminum deposition process that can autonomously apply or refresh high-reflectance optical coatings while on orbit."
  }
];

const leftItems = timeline.filter(item => item.category === "Spacecraft Accomplishments");
const rightItems = timeline.filter(item => item.category === "Telescope Coatings");
const centerItems = timeline.filter(item => item.category === "Active in Space");
---



<Layout>
<div class = "about-container">
<h1 class = "title" >About ZeCoat Corporation</h1>
<p>ZeCoat Corporation was founded in 2011 by David and Gillian Sheikh.  In 2012, Joshua Saadia joined ZeCoat and over the past decade, they have assembled a talented group of experts in the field of coating design, physical chemistry, electronics, mechanical design and software development to provide specialized vacuum capabilities to the astronomy community. 

ZeCoat has developed a unique vacuum coating system, which utilizes a motion-controlled electron beam evaporator,  which can uniformly coat substrates up to 2-meters in diameter with exceptional layer precision   (+/- 1.5%). 

In 2020, ZeCoat relocated from Torrance, California to Granite City, Illinois. The Illinois facility is centered on 3-acres, and is located on the Mississippi river with direct access to a municipal barge port. 
</p>
</div>
<div class = "ceo-wrapper">
<div class = "ceo-layout">
<div class = "ceo-image">
<img src = "/DavidHeadshot.webp" alt = "David Sheikh, CEO and Founder"/>
</div>
<div class = "ceo-description">
<div class= "name-group">
<h1>David Sheikh</h1>
<h2>CEO, Founder</h2>
</div>
<p>David A. Sheikh is the co-founder and CEO of ZeCoat Corporation, where he leads the development of advanced optical coating technologies for space, astronomy, and scientific research. With nearly four decades of experience in chemical engineering and vacuum deposition, he specializes in designing high-performance mirror coatings, thermal control coatings, and precision thin films for both ground-based and space-based optical systems.</p>
</div>
</div>
<div class = "ceo-layout">
<div class = "ceo-image">
</div>
<div class = "ceo-description">
<div class= "name-group">
<h1>Joshua Saadia</h1>
<h2>Operations Manager</h2>
</div>
<p>Joshua Saadia oversees engineering operations, manufacturing, and quality management at ZeCoat Corporation. With more than 20 years of experience in thin-film coatings and vacuum systems, he has supported major aerospace programs and helps bring advanced coating technologies from research into production.</p>
</div>
<div class = "ceo-image">
<img src = "/JoshHeadshot.webp" alt = "Joshua Saadia, Operations Manager"/>
</div>
</div>
</div>
<div class = "timeline-wrapper">
<div class = "timeline-header">
<div class = "timeline-title">Key Achievements</div>
</div>
<div class="timeline-layout">
  <div class="timeline-line"></div>

  <div class="timeline-column left-column">
    <div class = "title-cards">Spacecraft Accomplishments</div>
    {
      leftItems.map(item => (
        <ProjectCard
          title={item.title}
          description={item.description}
        />
      ))
    }
  </div>

  <div class="timeline-column right-column">
    <div class = "title-cards">Telesecope Coatings</div>
    {
      rightItems.map(item => (
        <ProjectCard
          title={item.title}
          description={item.description}
        />
      ))
    }
  </div>

</div>

{
  centerItems.map(item => (
    <div class="timeline-end">
      <ProjectCard
        title={item.title}
        description={item.description}
      />
    </div>
  ))
}
</div>
</Layout>

<style>

.ceo-description {
    display:flex;
    flex-direction: column;
    max-width: 600px;
    font-size: 18px;
}

.ceo-image img {
    width: 100%;
    max-width: 500px;
    height: 100%;
    max-height: 500px; 
    aspect-ratio: 5 / 4;
    object-fit: cover;
    transition: transform 0.4s ease;
    border: 1px solid #DCE3EA;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-radius: 16px;
}

.ceo-wrapper {
  display: flex;
  flex-direction: column;
  gap: 100px;
}

.timeline-wrapper {
    margin-block: 50px;
}

.title-cards {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
}

.ceo-image:hover img {
    transform: scale(1.03);
}

.section-title {
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    border-bottom: 3px solid black;
}

.timeline-title {
    font-size: 40px;
    letter-spacing: -0.03em;
}

.timeline-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    max-width: 1800px;
    margin: 0 auto;
    position: relative;
    padding-bottom: 150px;
    margin-inline: 20px;
}

.timeline-header {
    text-align: center;
    margin-bottom: 30px;
}

.timeline {
    position: relative;
    max-width: 1200px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
}

.timeline-item {
    width: 45%;
    position: relative;
}

.timeline-end {
    display: flex;
    justify-content: center;
    z-index: 10;
}

.left-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;      /* tight spacing */
}

.right-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;      /* even with left column by default */
    margin-top: 0;
}

/* Staggered zig-zag only when there's room for it */
@media (min-width: 1200px) {
    .right-column {
        gap: 4rem;
        margin-top: 150px;
    }
}
 
.timeline-wrapper {
  margin-block: 50px;
}

.timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;

    left: 50%;
    transform: translateX(-50%);

    width: 3px;
    background: #CBD4DC;
    z-index: 1;
}

.timeline-line::before {
    content: "";
    position: absolute;

    width: 16px;
    height: 16px;

    border-radius: 50%;
    background: #E7A21C;

    left: 67%;
    transform: translateX(-50%);

    top: -8px; 
}

.timeline-item.center {
    width: 100%;
    display: flex;
    justify-content: center;
}

.project-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1000px;    
    margin-inline: auto;
    align-items: center;
    margin-bottom: 5rem;
    padding-inline: 20px
}

.ceo-layout {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 4vw, 150px);
    padding-inline: 20px;
}

.title {
    font-size: 60px;
    margin-bottom: 0.5rem;
}

.title-cards {
  text-align: center;
}

.about-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 8rem;
    padding-inline: 20px;
}

.about-container p {
    max-width: 125ch;
    margin-top: 5;
}

.name-group {
    display: flex;
    flex-direction: column;
    gap: -1000rem;
}

.ceo-description h1,
.ceo-description h2{
    margin: 0;
}


@media (max-width: 1000px) {

  .title{
    font-size: 48px;
    text-align:center;
  }
  
  .ceo-wrapper {
  display: flex;
  flex-direction: column;
  gap: 50px;
}

  .ceo-layout{
    flex-direction:column;
    align-items:center;
    gap:2rem;
  }

  .ceo-description{
    text-align:center;
    align-items:center;
  }

  .ceo-image img{
    max-width:450px;
    width:100%;
    height:auto;
  }

  .timeline-line::after {
    content: "";
    position: absolute;

    width: 16px;
    height: 16px;

    border-radius: 50%;
    background: #E7A21C;

    left: 50%;
    transform: translateX(-50%);

    bottom: -8px; 
}

}

@media (max-width:900px){

.timeline-layout{
    grid-template-columns:1fr;
    gap:2rem;
}


.timeline-column{
    padding-left:50px;
}


.timeline-line{
    left:24px;
    transform:none;
}

.left-column,
.right-column{
    margin-top:0;
    
}
}

@media (max-width:768px){

.about-container{

    padding-inline:24px;
}

.about-container p{

    line-height:1.8;
}
}

@media (max-width:768px){

.ceo-description h1{

    font-size:2rem;
}

.ceo-description h2{

    font-size:1.2rem;
}

.ceo-description h3{

    font-size:1rem;
    line-height:1.7;
}

}

</style>