<style>
.page-layout {
    display: flex;
    justify-content: center;
    padding: 40px 20px;
    min-height: 100vh;
}

.profile-container {
    width: 100%;
    max-width: 800px;
}

.profile-content {
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 10px 30px rgba(16, 24, 40, 0.06);
}

.profile-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 30px;
    margin-bottom: 40px;
}

/* Two equal halves: the name is centered in the left half,
   the photo is centered in the right half. */
.profile-header > h1,
.profile-photo-wrap {
    flex: 1 1 0;
    min-width: 0;
}

.profile-header > h1 {
    text-align: center;
}

.profile-photo-wrap {
    display: flex;
    justify-content: center;
}

.profile-photo {
    width: 300px;
    height: 300px;
    border-radius: 12px;
    object-fit: cover;
    object-position: center;
    flex-shrink: 0;
    border: 3px solid #E2E8F0;
    box-shadow: 0 4px 12px rgba(16, 24, 40, 0.1);
}

.profile-content h1 {
    font-size: 2.5rem;
    color: #16202E;
    margin: 0;
}

.section {
    margin-bottom: 30px;
}

.section h2 {
    font-size: 1.5rem;
    color: #16202E;
    margin: 0 0 15px 0;
}

.section p {
    font-size: 1rem;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 16px 0;
}

.section p:last-child {
    margin-bottom: 0;
}

.education-list,
.experience-list {
    list-style-position: inside;
    padding-left: 0;
    margin: 0;
}

.publication-list,
.grant-list {
    padding-left: 1.4em;
    margin: 0;
}

.publication-list li,
.grant-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 10px;
    padding-left: 4px;
}

.publication-list strong,
.grant-list strong {
    color: #16202E;
    font-weight: 600;
}

.education-list li,
.experience-list li {
    font-size: 1rem;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 12px;
}

.education-list li:last-child,
.experience-list li:last-child {
    margin-bottom: 0;
}

.education-list strong,
.experience-list strong {
    color: #16202E;
}

hr {
    border: none;
    border-top: 1px solid #E2E8F0;
    margin: 30px 0;
}

@media (max-width: 600px) {
    .profile-content {
        padding: 24px;
    }

    .profile-photo {
        width: 150px;
        height: 150px;
        margin-bottom: 15px;
    }

    .profile-content h1 {
        font-size: 1.8rem;
    }

    .section h2 {
        font-size: 1.2rem;
    }

    .section p,
    .education-list li,
    .experience-list li,
    .publication-list li,
    .grant-list li {
        font-size: 0.95rem;
    }
}
</style>
