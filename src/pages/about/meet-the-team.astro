<style>

.ceo-description {
    display:flex;
    flex-direction: column;
    max-width: 600px;
    font-size: 18px;
}

.ceo-image img {
    width: 100%;
    max-width: 500px;
    height: 100%;
    max-height: 500px; 
    aspect-ratio: 5 / 4;
    object-fit: cover;
    transition: transform 0.4s ease;
    border: 1px solid #DCE3EA;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-radius: 16px;
}

.ceo-wrapper {
  display: flex;
  flex-direction: column;
  gap: 100px;
  margin-bottom: 150px;
}

.title-cards {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
}

.ceo-image:hover img {
    transform: scale(1.03);
}

.section-title {
    width: 100%;
    max-width: 1000px;
    margin-inline: auto;
    border-bottom: 3px solid black;
}

.ceo-layout {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 4vw, 150px);
    padding-inline: 20px;
}

.title {
    font-size: 60px;
    margin-bottom: 0.5rem;
}

.about-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 8rem;
    padding-inline: 20px;
}

.about-container p {
    max-width: 125ch;
    margin-top: 5;
}

.name-group {
    display: flex;
    flex-direction: column;
    gap: -1000rem;
}

.ceo-description h1,
.ceo-description h2{
    margin: 0;
}


@media (max-width: 1000px) {

  .title{
    font-size: 48px;
    text-align:center;
  }
  
  .ceo-wrapper {
  display: flex;
  flex-direction: column;
  gap: 50px;
}

  .ceo-layout{
    flex-direction:column;
    align-items:center;
    gap:2rem;
  }

  .ceo-description{
    text-align:center;
    align-items:center;
  }

  .ceo-image img{
    max-width:450px;
    width:100%;
    height:auto;
  }

}

@media (max-width:768px){

.about-container{

    padding-inline:24px;
}

.about-container p{

    line-height:1.8;
}
}

@media (max-width:768px){

.ceo-description h1{

    font-size:2rem;
}

.ceo-description h2{

    font-size:1.2rem;
}

.ceo-description h3{

    font-size:1rem;
    line-height:1.7;
}

}

</style>
