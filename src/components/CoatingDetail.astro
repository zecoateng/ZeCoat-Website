---
// Shared content block for a single coating-variant detail page
// (e.g. /coatings/protected-silver/kepler). Used inside <Layout>.
// Laid out in columns so the key information fits on one screen:
//   column 1: picture, description, specs, publications, quote button
//   column 2: reflectance by band
//   column 3: environmental durability (only when provided)
import ReflectanceTable from './ReflectanceTable.astro';

const {
  title,
  familyLabel,
  familyHref,
  image,
  description,
  specs = [],
  bands = [],
  bandGroups = [],
  mergeBandGroups = false,
  publications = [],
  linksHeading = "Publications",
  durability = [],
  properties = null,
  reflectanceNote = "",
} = Astro.props;

const hasDurability = durability.length > 0;
const hasProperties = !!properties && properties.rows.length > 0;
const hasReflectance = bands.length > 0 || bandGroups.length > 0 || hasProperties;
---

<div class="detail-layout">
  <div class="detail-top">
    <a class="back-link" href={familyHref}>&larr; Back to {familyLabel}</a>
    <h1>{title}</h1>
  </div>

  <div class:list={["detail-grid", { "has-durability": hasDurability, "info-only": !hasReflectance && !hasDurability, "durability-only": hasDurability && !hasReflectance }]}>
    <section class="col col-info">
      {image && (
        <img src={image} alt={title} class="detail-image" />
      )}

      <p class="detail-description">{description}</p>

      {specs.length > 0 && (
        <ul class="detail-specs">
          {specs.map((item) => (
            <li><strong>{item.label}:</strong> {item.value}</li>
          ))}
        </ul>
      )}

      {publications.length > 0 && (
        <div class="pubs">
          <h2>{linksHeading}</h2>
          <ul class="pub-list">
            {publications.map((pub) => (
              <li>
                {pub.url ? <a href={pub.url} target="_blank" rel="noopener">{pub.title}</a> : <span>{pub.title}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}

      <a class="quote-button" href="/contact">Request a Quote</a>
    </section>

    {hasProperties && (
    <section class="col col-reflectance">
      <h2>{properties.title}</h2>
      <div class="durability-wrap">
        <table class="durability-table">
          <thead>
            <tr>
              <th>Property</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            {properties.rows.map((row) => (
              <tr>
                <td>{row.property}</td>
                <td>{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    )}

    {!hasProperties && hasReflectance && (
    <section class="col col-reflectance">
      <h2>Reflectance by Band</h2>
      <ReflectanceTable bands={bands} groups={bandGroups} merge={mergeBandGroups} />
      {reflectanceNote && <p class="reflectance-note">{reflectanceNote}</p>}
    </section>
    )}

    {hasDurability && (
      <section class="col col-durability">
        <h2>Environmental Durability</h2>
        <div class="durability-wrap">
          <table class="durability-table">
            <thead>
              <tr>
                <th>Test</th>
                <th>Specification</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {durability.map((row) => (
                <tr>
                  <td>{row.test}</td>
                  <td>{row.spec}</td>
                  <td>{row.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}
  </div>
</div>

<style>
  .detail-layout {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem 2rem;
  }

  .detail-top {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .back-link {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    align-self: flex-start;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .detail-top h1 {
    font-size: clamp(1.6rem, 2.2vw + 0.6rem, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: black;
    margin: 0;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .detail-grid.info-only {
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
  }

  .detail-grid.has-durability.durability-only {
    grid-template-columns: minmax(260px, 340px) minmax(0, 640px);
    justify-content: center;
  }

  .detail-grid.info-only .detail-image {
    max-height: 380px;
  }

  .detail-grid.has-durability {
    grid-template-columns: minmax(260px, 320px) minmax(300px, 380px) minmax(0, 1fr);
  }

  .col h2 {
    font-size: 1.1rem;
    color: #16202E;
    margin: 0 0 0.6rem;
  }

  .col-info {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .detail-image {
    width: 100%;
    max-height: 190px;
    object-fit: contain;
    background: #F8F9FB;
    border-radius: 12px;
    border: 1px solid #E2E8F0;
  }

  .detail-description {
    color: #1B2430;
    line-height: 1.55;
    font-size: 0.95rem;
    margin: 0;
  }

  .detail-specs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .detail-specs li {
    color: #1B2430;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .detail-specs strong {
    color: #16202E;
  }

  .pubs h2 {
    font-size: 1rem;
  }

  .pub-list {
    margin: 0;
    padding-left: 1.1rem;
  }

  .pub-list li {
    margin-bottom: 0.4rem;
    color: #1B2430;
    font-size: 0.88rem;
  }

  .pub-list a {
    color: #C6870F;
    font-weight: 600;
    text-decoration: none;
  }

  .pub-list a:hover {
    text-decoration: underline;
  }

  .quote-button {
    align-self: flex-start;
    background: #E7A21C;
    color: #1B2430;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid #E7A21C;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .quote-button:hover {
    background: #C6870F;
    transform: translateY(-2px);
  }

  .reflectance-note {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    line-height: 1.4;
    color: #475569;
  }

  .durability-wrap {
    width: 100%;
    overflow-x: auto;
    border: 1px solid #DCE2E8;
    border-radius: 12px;
  }

  .durability-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
  }

  .durability-table th,
  .durability-table td {
    padding: 0.35rem 0.6rem;
    text-align: left;
    vertical-align: top;
    line-height: 1.3;
  }

  .durability-table thead th {
    background: #16202E;
    color: #ffffff;
    font-weight: 600;
    white-space: nowrap;
  }

  .durability-table tbody tr:nth-child(odd) {
    background: #F8F9FB;
  }

  .durability-table tbody td {
    color: #1B2430;
    border-top: 1px solid #EAEDF1;
  }

  .durability-table tbody td:first-child {
    font-weight: 600;
    color: #16202E;
  }

  /* Narrower screens: info column on top, tables share the next row */
  @media (max-width: 1150px) {
    .detail-grid.has-durability {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .detail-grid.has-durability .col-info {
      grid-column: 1 / -1;
    }

    .detail-grid.has-durability.durability-only {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 800px) {
    .detail-grid,
    .detail-grid.has-durability {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
