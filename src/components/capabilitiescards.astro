---
const {imgSrc, cardTitle, cardBody} = Astro.props
---

<div class="card">
  <img src={imgSrc} class="card-img-top" alt="Card Image">
  <div class="card-body">
    <h5 class="card-title">{cardTitle}</h5>
    <p class="card-text">{cardBody}</p>
  </div>
</div>

<style>

.card-img-top {
    width:100%;
}
.card {
    background-color:#D9F99D;
    max-width: 300px;
}

</style>