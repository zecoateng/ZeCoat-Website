---
const {title, description, image, link} = Astro.props;
---

    <div class="ceo-layout">
    <div class="ceo-image">
        <img src={image} />
    </div>

    <div class="ceo-description">
        <div class="name-group">
            <h1>{title}</h1>
        </div>

        <p>
           {description}
        </p>
        <div class = "bottom">
            <a href={link}>Learn more</a>
        </div>
    </div>
   
</div>
 <hr>


<style>

.ceo-layout {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 4vw, 150px);
    padding: 20px;
    border-style: solid;
    border-color: #D1D5DB;
    border-width: 2px;
    background-color: #F8F9FB;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.ceo-image img {
    width: 100%;
    height: auto;
    max-width: 400px;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border: 1px solid #DCE3EA;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-radius: 8px;
}

.ceo-description {
    display: flex;
    flex-direction: column;
    max-width: 600px;
}

a {
    text-decoration: none;
    background:#E7A21C;
    color: #1B2430;
    transition: transform 0.3s ease;
}

a:hover {
    background:#C6870F;
    transform: translateY(-2px);
}

.name-group {
    display: flex;
    flex-direction: column;
    font-size: clamp(0.5rem, 3vw, 1rem);
}

.ceo-description h1,
.ceo-description h2 {
    margin: 0;
}

.bottom a{
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1.75rem;

    

    border-radius: 8px;

    font-weight: 600;
    font-size: 0.95rem;
}

.ceo-description p {
    max-width: 450px;
}

@media (max-width: 1000px) {
    .ceo-layout {
        flex-direction: column;
        align-items: center;
        padding-inline: 10px;
    }
}
</style>