---
const {} = Astro.props;
---

    <div class="ceo-layout">
    <div class="ceo-image">
        <img src="/public/dock-layout.png" />
    </div>

    <div class="ceo-description">
        <div class="name-group">
            <h1>Battery-Powered Deposition</h1>
        </div>

        <p>
           A new coating process that uses multiple controlled evaporation sources to produce highly uniform optical coatings in seconds for large mirrors and future space applications.
        </p>
        <div class = "bottom">
            <div>Applications</div>
            <a href="/TechnologyLayout">Learn more</a>
        </div>
    </div>
   
</div>
 <hr>


<style>

.ceo-layout {
    display: flex;
    justify-content: center;
    gap: clamp(10px, 4vw, 150px);
    padding: 20px;
    border-style: solid;
    border-color: black;
    border-width: 2px;
    background-color: white;
    border-radius: 5px;
}

.ceo-image img {
    width: 100%;
    height: auto;
    max-width: 400px;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    transition: transform 0.4s ease;
    border: 1px solid #DCE3EA;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    border-radius: 10px;
}

.ceo-image:hover img {
    transform: scale(1.03);
}

.ceo-description {
    display: flex;
    flex-direction: column;
    max-width: 600px;
}

a {
    text-decoration: none;
}

.name-group {
    display: flex;
    flex-direction: column;
    font-size: clamp(0.5rem, 3vw, 1rem);
}

.ceo-description h1,
.ceo-description h2 {
    margin: 0;
}

.bottom {
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.ceo-description p {
    max-width: 450px;
}

@media (max-width: 1000px) {
    .ceo-layout {
        flex-direction: column;
        align-items: center;
        padding-inline: 10px;
    }
}
</style>