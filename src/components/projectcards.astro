---
const {title, description} = Astro.props
---

<section class = "section-container">
<h2>{title}</h2>
<p>{description}</p>
</section>

<style>
.section-container {
  background: #FFFFFF;
    border-style: solid;
    border: 1px solid #CBD4DC;
    border-radius: 18px;
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
opacity: 0;
  transform: translateY(30px);

  animation: fadeUp 0.7s ease forwards;
}

h2 {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.3;
    margin-bottom: 1rem;
    color: #000000;
}

p {
    font-size: 1rem;
    line-height: 1.6;
    color: #000000;
    margin: 0;
}


@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* Tablet */
@media (max-width: 1024px) {

    .section-container {
        max-width: 320px;
        padding: 1.25rem;
    }

}


/* Mobile */
@media (max-width: 768px) {

    .section-container {
        width: 100%;
        max-width: 380px;

        padding: 1.25rem;
        min-height: auto;

        border-radius: 14px;
    }

    h2 {
        font-size: 1.4rem; /* ~22px */
        text-align: center;
    }

    p {
        font-size: 1rem; /* 16px */
        text-align: center;
    }

}


/* Small phones */
@media (max-width: 400px) {

    .section-container {
        padding: 1rem;
    }

    h2 {
        font-size: 1.25rem; /* 20px */
    }

    p {
        font-size: .95rem;
    }

}
</style>
</style>