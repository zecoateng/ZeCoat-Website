---
const {title, description} = Astro.props
---

<section class = "section-container">
<h2>{title}</h2>
<p>{description}</p>
</section>

<style>
.section-container {
    background: white;
    border: 1px solid #dce3ea;
    border-radius: 18px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);

}

</style>