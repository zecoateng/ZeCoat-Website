---
const { image, title, description, reflectance, durability, heritage, maxSize, priceDrivers } = Astro.props;
---

<section class="carousel">


        <article class="card">

            <img
                src={image}
                alt={title}
            />

            <div class="card-body">

                <h2>{title}</h2>

                <p>{description}</p>

                {reflectance &&
                    <p><strong>Reflectance:</strong> {reflectance}</p>
                }

                {durability &&
                    <p><strong>Durability:</strong> {durability}</p>
                }

                {heritage &&
                    <p><strong>Flight Heritage:</strong> {heritage}</p>
                }

                {maxSize &&
                    <p><strong>Max Size:</strong> {maxSize}</p>
                }

                {priceDrivers &&

                    <div>

                        <strong>Price Drivers</strong>

                        <ul>

                            {priceDrivers.map(driver => (
                                <li>{driver}</li>
                            ))}

                        </ul>

                    </div>

                }

                <div class="graph-placeholder">

                    Reflectance Graph

                    <span>(Coming Soon)</span>

                </div>

            </div>

        </article>

</section>

<style>
      .carousel{

    display:flex;

    gap:2rem;

    overflow-x:auto;

    padding:3rem;

    scroll-snap-type:x mandatory;
}

.card{

    min-width:430px;

    width: 100%;

    background:white;

    border-radius:18px;

    overflow:hidden;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

    scroll-snap-align:start;
}

.card img{

    width:100%;

    height:240px;

    object-fit:cover;
}

.card-body{

    padding:2rem;

    display:flex;

    flex-direction:column;

    gap:1rem;
}

.graph-placeholder{

    height:220px;

    border:2px dashed #CBD5E1;

    border-radius:10px;

    display:flex;

    justify-content:center;

    align-items:center;

    flex-direction:column;

    color:#64748B;
}

.card button{

    margin-top:auto;

    padding:1rem;

    background:#1E293B;

    color:white;

    border:none;

    border-radius:8px;

    cursor:pointer;
}
</style>