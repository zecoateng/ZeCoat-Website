---
const {imgSrc, cardTitle, cardBody, variant = "default"} = Astro.props
---

<div class:list={["card", variant]}>
  <img src={imgSrc} class="card-img-top" alt="Card Image">
  <div class="card-body">
    <h3 class="card-title">{cardTitle}</h3>
    <p class="card-text">{cardBody}</p>
  </div>
</div>

<style>

.card.experiences .card-img-top {
    width: 100%;
    max-height: 50%;
}

.card.default .card-img-top {
    width: 100%;
    max-height: 50%;   
}

.card {
  max-width: 380px;
}


.card.featured .card-img-top {
    width: 100%;
    height: 250px;
    object-fit: cover;
    object-position: center;
}


.card.default {
  background:
linear-gradient(
180deg,
#ffffff,
#f7f9fc
);

border:1px solid rgba(0,0,0,.06);

box-shadow:
0 12px 40px rgba(0,0,0,.08);
  border-radius: 8px;
  overflow: hidden;
  max-width: 400px;
  max-height: 700px;
  box-shadow:
0 10px 25px rgba(0,0,0,.08);

  border-color:#1E293B;
  border-width: 1px;
}


.card .card-body {
  padding: 10px;
}

.card.experiences .card-img-top {
  width: 100%;
  
  height: 100%;
  max-height: 100px;
}

.card.experiences .card-title {
  font-size: 20px;
}

.card.experiences {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.card.experiences .card-body {
  height: 100%;
}

.card.featured {
    background: #FFFFFF;
    border: 1px solid #dce3ea;
    border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
    transition: 0.3s;
}

.card.featured:hover {
  transform: translateY(-8px);
}

</style>