---
const {imgSrc, cardTitle, cardBody, variant = "default"} = Astro.props
---

<div class:list={["card", variant]}>
  <img src={imgSrc} class="card-img-top" alt="Card Image">
  <div class="card-body">
    <h5 class="card-title">{cardTitle}</h5>
    <p class="card-text">{cardBody}</p>
  </div>
</div>

<style>

.card-img-top {
    width:100%;
    max-height: 50%;
}

.card.default {
  background: white;
  border: 1px solid #DCE3EA;
  border-radius: 16px;
  overflow: hidden;
  max-width: 300px;
  max-height: 700px;
  box-shadow:
0 10px 25px rgba(0,0,0,.08);


}


.card .card-body {
  padding: 10px;
}

.card.experiences .card-img-top {
  width: 100%;
  max-width: 200px;
}

.card.experiences .card-title {
  font-size: 20px;
}

.card.experiences {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  
}
/*make sure that you make a line in between the cards at some point */

.card.featured {
    background: #ECE8E3;
    border: 1px solid #dce3ea;
    border-radius: 18px;
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.08);
    transition: 0.3s;
}

.card.featured:hover {
  transform: translateY(-8px);
}

</style>