---
// A clickable tile used on the main Coatings page (linking to a coating
// family) and on each family page (linking to a specific variant/product).
// Image is cropped to fill the box; click anywhere on the tile to learn more.
const { title, image, description, link } = Astro.props;
---

<a class="coating-tile" href={link}>
  {image && <img src={image} alt={title} />}
  <div class="coating-tile-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="learn-more">Learn More &rarr;</span>
  </div>
</a>

<style>
  .coating-tile {
    background: linear-gradient(180deg, #ffffff, #f7f9fc);
    border: 1px solid #DCE2E8;
    border-radius: 14px;
    overflow: hidden;
    height: 100%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .coating-tile:hover {
    box-shadow: 0 16px 40px rgba(0, 0, 0, .12);
    transform: translateY(-4px);
  }

  .coating-tile img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center;
  }

  .coating-tile-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .coating-tile-body h3 {
    font-size: 1.3rem;
    color: #16202E;
    margin: 0;
  }

  .coating-tile-body p {
    color: #1B2430;
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .learn-more {
    font-weight: 600;
    color: #C6870F;
  }

  .coating-tile:hover .learn-more {
    text-decoration: underline;
  }
</style>
