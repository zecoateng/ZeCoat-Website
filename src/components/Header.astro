<script>
import { actions } from "astro:actions";
import { any } from "astro:schema";

let lastScrollTop = 0;

function handleScroll() {
  const header = document.querySelector('header');

  let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
  
  if (scrollTop > lastScrollTop) {
    // Scrolling down: hide the header
    header.classList.add('header-hidden');
  } else {
    // Scrolling up: show the header
    header.classList.remove('header-hidden');
  }
  
  lastScrollTop = scrollTop <= 0 ? 0 : scrollTop; // Prevent negative values
};

function setActiveLink() {
  const button = document.querySelectorAll('.header a')

  button.forEach(btn=> {
    if (btn.getAttribute('href') === window.location.pathname) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
    });
  }

document.addEventListener('astro:page-load', setActiveLink);

window.addEventListener('scroll', handleScroll);
document.addEventListener('astro:page-load', handleScroll);

document.addEventListener("astro:page-load", () => {
  const menuButton = document.querySelector(".open-menu");
  const navigation = document.querySelector(".navigation");
  const overlay = document.querySelector(".menu-overlay");
  const width = window.innerWidth;

  menuButton?.addEventListener("click", () => {
    navigation?.classList.toggle("open");
    overlay?.classList.toggle("active");
  });
          
  overlay?.addEventListener("click", () => {
    navigation?.classList.remove("open");
    overlay?.classList.remove("active");
  });

  window.addEventListener('resize', () => {
    if (width > 900) {
      overlay?.classList.remove("active");
      navigation?.classList.remove("open")
    }
  }) 

  setActiveLink();
});


</script>

